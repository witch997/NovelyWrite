{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovelyWrite",
  "version": "0.7.0",
  "identifier": "com.novelywrite.app",
  "build": {
    "frontendDist": "../webview",
    "devUrl": "http://127.0.0.1:3081"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/nw-server"],
    "resources": []
  },
  "plugins": {
    "shell": {
      "open": false
    }
  }
}
